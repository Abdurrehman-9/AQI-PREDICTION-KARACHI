# =============================================
# AQI Predictor — Environment Variables
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# --- API Keys ---
AQICN_TOKEN=your_aqicn_api_token_here
OWM_API_KEY=your_openweathermap_api_key_here

# --- Hopsworks Feature Store & Model Registry ---
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT=aqi_karachi

# --- App Config ---
KARACHI_STATION_ID=@karachi   # AQICN station ID for Karachi
KARACHI_LAT=24.8607
KARACHI_LON=67.0011

# --- Alert Config ---
ALERT_AQI_THRESHOLD=150       # AQI level to trigger hazard alert
